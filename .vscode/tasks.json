{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "buildEnv",
      "type": "pickString",
      "description": "Chọn environment",
      "options": [
        "dev",
        "stg",
        "prod"
      ],
      "default": "dev"
    },
    {
      "id": "flutterVersion",
      "type": "promptString",
      "description": "Nhập phiên bản Flutter (VD: 3.27.3, stable, beta)",
      "default": "stable"
    },
    {
      "id": "newPackageName",
      "type": "promptString",
      "description": "Nhập tên package mới (VD: dat_san_247_mobile)",
      "default": "flutter_base"
    },
    {
      "id": "newAppLabel",
      "type": "promptString",
      "description": "Nhập tên hiển thị ứng dụng (VD: Đặt Sân 247)",
      "default": "Đặt Sân 247"
    }
  ],
  "tasks": [
    // ═══════════════════════════════════════════════════════════
    // 🚀 CORE BUILD TASKS (Most Used)
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🚀 Build APK",
      "type": "shell",
      // "command": "fvm flutter build apk --flavor ${input:buildEnv} -t lib/main_${input:buildEnv}.dart --release",
      "command": "fvm flutter build apk --flavor ${input:buildEnv} -t lib/main_${input:buildEnv}.dart --release --obfuscate --split-debug-info=build/debug-symbols --target-platform android-arm64",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "🏬 Build AAB",
      "type": "shell",
      "command": "fvm flutter build appbundle --flavor ${input:buildEnv} -t lib/main_${input:buildEnv}.dart --release --obfuscate --split-debug-info=build/debug-symbols",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "🍎 Build iOS",
      "type": "shell",
      "command": "fvm flutter build ios --flavor ${input:buildEnv} -t lib/main_${input:buildEnv}.dart --release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "📦 Build IPA",
      "type": "shell",
      "command": "fvm flutter build ipa --flavor ${input:buildEnv} -t lib/main_${input:buildEnv}.dart --release --obfuscate --split-debug-info=build/debug-symbols",
      "group": "build",
      "problemMatcher": []
    },
    // ═══════════════════════════════════════════════════════════
    // ⚡ CODE GENERATION
    // ═══════════════════════════════════════════════════════════
    {
      "label": "⚡ Build Runner",
      "type": "shell",
      "command": "fvm dart run build_runner build --delete-conflicting-outputs",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "👁️ Build Runner Watch",
      "type": "shell",
      "command": "fvm dart run build_runner watch --delete-conflicting-outputs",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🌐 Generate l10n",
      "type": "shell",
      "command": "fvm flutter gen-l10n",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🌐 Sync l10n (arb)",
      "type": "shell",
      "command": "fvm dart run lib/core/l10n/tool/l10n_sync.dart",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    // ═══════════════════════════════════════════════════════════
    // 🧹 MAINTENANCE
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🧹 Clean & Get",
      "type": "shell",
      "command": "fvm flutter clean && fvm flutter pub get",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔄 Full Regenerate",
      "type": "shell",
      "command": "fvm flutter clean && fvm flutter pub get && fvm flutter gen-l10n && fvm dart run build_runner build --delete-conflicting-outputs",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "📦 Pub Get",
      "type": "shell",
      "command": "fvm flutter pub get",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "⬆️ Pub Upgrade",
      "type": "shell",
      "command": "fvm flutter pub upgrade --major-versions",
      "group": "build",
      "problemMatcher": []
    },
    // ═══════════════════════════════════════════════════════════
    // 🔧 QUALITY & ANALYSIS
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🔧 Flutter Doctor",
      "type": "shell",
      "command": "fvm flutter doctor -v",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "📊 Analyze & Fix",
      "type": "shell",
      "command": "fvm flutter analyze && fvm dart fix --apply",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "✨ Format",
      "type": "shell",
      "command": "fvm dart format .",
      "group": "build",
      "problemMatcher": []
    },
    // ═══════════════════════════════════════════════════════════
    // 🧪 TESTING
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🧪 Test",
      "type": "shell",
      "command": "fvm flutter test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "📈 Test Coverage",
      "type": "shell",
      "command": "fvm flutter test --coverage && genhtml coverage/lcov.info -o coverage/html",
      "group": "test",
      "problemMatcher": []
    },
    // ═══════════════════════════════════════════════════════════
    // 🧱 MASON & FLAVORIZR
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🧱 Mason: Generate Feature",
      "type": "shell",
      "command": "mason make feature --on-conflict overwrite",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "� Flutter Flavorizr",
      "type": "shell",
      "command": "fvm flutter pub run flutter_flavorizr",
      "group": "build",
      "problemMatcher": []
    },
    // ═══════════════════════════════════════════════════════════
    // 🎨 ICONS & SPLASH
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🎨 Generate App Icons",
      "type": "shell",
      "command": "fvm flutter pub run flutter_launcher_icons",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "🌊 Generate Native Splash",
      "type": "shell",
      "command": "fvm flutter pub run flutter_native_splash:create",
      "group": "build",
      "problemMatcher": []
    },
    // ═══════════════════════════════════════════════════════════
    // 🔧 FVM MANAGEMENT
    // ═══════════════════════════════════════════════════════════
    {
      "label": "📋 FVM List",
      "type": "shell",
      "command": "fvm list",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🌐 FVM Releases",
      "type": "shell",
      "command": "fvm releases",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔍 FVM Global",
      "type": "shell",
      "command": "fvm global",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📥 FVM Install",
      "type": "shell",
      "command": "fvm install ${input:flutterVersion}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔧 FVM Use",
      "type": "shell",
      "command": "fvm use ${input:flutterVersion}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🗑️ FVM Remove",
      "type": "shell",
      "command": "fvm remove ${input:flutterVersion}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    // ═══════════════════════════════════════════════════════════
    // 🛠️ REFACTORING
    // ═══════════════════════════════════════════════════════════
    {
      "label": "🔧 Rename Package",
      "type": "shell",
      "command": "powershell -Command \"$oldName = (Get-Content pubspec.yaml | Select-String -Pattern '^name: ' | ForEach-Object { $_.Line.Split(':')[1].Trim() }); Write-Host 'Renaming package from' $oldName 'to ${input:newPackageName}...'; (Get-Content pubspec.yaml) -replace ('name: ' + $oldName), ('name: ' + '${input:newPackageName}') | Set-Content pubspec.yaml; Get-ChildItem -Recurse -Include *.dart | ForEach-Object { (Get-Content $_.FullName) -replace ('package:' + $oldName), ('package:' + '${input:newPackageName}') | Set-Content $_.FullName }; fvm flutter clean; fvm flutter pub get\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "🏷️ Rename App Label (Display Name)",
      "type": "shell",
      "command": "fvm flutter pub run rename setAppName --value \"${input:newAppLabel}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
