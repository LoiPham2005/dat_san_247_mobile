[
  // ═══════════════════════════════════════════════════════════
  // 🚀 MAIN ACTIONS (Most Used)
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+shift+b",
    "command": "workbench.action.tasks.runTask",
    "args": "🚀 Build APK (Universal)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+r",
    "command": "workbench.action.tasks.runTask",
    "args": "⚡ Build Runner (One-time)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+w",
    "command": "workbench.action.tasks.runTask",
    "args": "👁️ Build Runner (Watch)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+c",
    "command": "workbench.action.tasks.runTask",
    "args": "🧹 Clean & Get",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 🏗️ QUICK BUILDS - APK
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+shift+1",
    "command": "workbench.action.tasks.runTask",
    "args": "📦 Build APK (Dev)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+2",
    "command": "workbench.action.tasks.runTask",
    "args": "📦 Build APK (Stg)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+3",
    "command": "workbench.action.tasks.runTask",
    "args": "📦 Build APK (Prod)",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 🏗️ QUICK BUILDS - AAB
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+shift+a",
    "command": "workbench.action.tasks.runTask",
    "args": "🏬 Build AAB (Universal)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+1",
    "command": "workbench.action.tasks.runTask",
    "args": "🏬 Build AAB (Dev)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+2",
    "command": "workbench.action.tasks.runTask",
    "args": "🏬 Build AAB (Stg)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+3",
    "command": "workbench.action.tasks.runTask",
    "args": "🏬 Build AAB (Prod)",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 🍎 iOS BUILDS
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+shift+i",
    "command": "workbench.action.tasks.runTask",
    "args": "🍎 Build iOS (Universal)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+p",
    "command": "workbench.action.tasks.runTask",
    "args": "📦 Build IPA (Universal)",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 📦 PUB COMMANDS
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+alt+g",
    "command": "workbench.action.tasks.runTask",
    "args": "📦 Pub Get",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+u",
    "command": "workbench.action.tasks.runTask",
    "args": "⬆️ Pub Upgrade",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+o",
    "command": "workbench.action.tasks.runTask",
    "args": "🔍 Pub Outdated",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 🎯 CODE GENERATION
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+alt+b",
    "command": "workbench.action.tasks.runTask",
    "args": "🎯 Build Runner (Current File)",
    "when": "editorLangId == dart"
  },
  {
    "key": "ctrl+alt+l",
    "command": "workbench.action.tasks.runTask",
    "args": "🌐 Generate l10n",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 🔧 FLUTTER COMMANDS
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+alt+d",
    "command": "workbench.action.tasks.runTask",
    "args": "🔧 Flutter Doctor",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+a",
    "command": "workbench.action.tasks.runTask",
    "args": "📊 Flutter Analyze",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+f",
    "command": "workbench.action.tasks.runTask",
    "args": "✨ Dart Format",
    "when": "editorTextFocus"
  },

  // ═══════════════════════════════════════════════════════════
  // 🐛 DEBUG RUNS
  // ═══════════════════════════════════════════════════════════
  {
    "key": "ctrl+alt+shift+1",
    "command": "workbench.action.tasks.runTask",
    "args": "🐛 Run Debug (Dev)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+shift+2",
    "command": "workbench.action.tasks.runTask",
    "args": "🐛 Run Debug (Stg)",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+shift+3",
    "command": "workbench.action.tasks.runTask",
    "args": "🐛 Run Debug (Prod)",
    "when": "editorTextFocus"
  },
    {
    "key": "ctrl+alt+s",
    "command": "workbench.action.tasks.runTask",
    "args": "🌐 Sync l10n (arb)",
    "when": "editorTextFocus"
  }

  // ═══════════════════════════════════════════════════════════
  // 🐛 DEFAULT DEBUG SHORTCUTS (Keep VSCode defaults)
  // ═══════════════════════════════════════════════════════════
  // F5:              Start Debugging
  // Ctrl+Shift+F5:   Hot Restart
  // Shift+F5:        Stop Debugging
  // Ctrl+F5:         Run Without Debugging
  // Ctrl+Shift+D:    Show Debug Panel
]
